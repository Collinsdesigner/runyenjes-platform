// Runyenjes Technical & Vocational College — Database Schema
// This file is the single source of truth for every table in the system.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// IDENTITY & SETTINGS
// ─────────────────────────────────────────────

// One row only. Holds the institution's name/branding so it can be
// changed from a settings screen later without touching any code.
model SiteSettings {
  id              Int    @id @default(1)
  institutionName String @default("Runyenjes Technical & Vocational College")
  shortName       String @default("Runyenjes")
  tagline         String @default("Empowering Through Skills and Technology")

  logoUrl      String?
  logoPublicId String?

  primaryColor     String   @default("#0B7A2B")
  secondaryColor   String   @default("#5C0F00")
  address          String   @default("P.O. Box 239-60103, Runyenjes")
  phone            String   @default("0797210054")
  email            String   @default("runyenjestti@gmail.com")
  website          String   @default("www.runyenjestechnical.ac.ke")
  about            String?
  physicalLocation String?
  googleMapsUrl    String?
  updatedAt        DateTime @default(now()) @updatedAt
}

enum Role {
  ADMIN
  REGISTRAR
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model User {
  id              String      @id @default(uuid())
  name            String
  email           String      @unique
  passwordHash    String?
  admissionNumber String?     @unique
  phone           String?
  avatarUrl       String?
  avatarPublicId  String?
  role            Role
  status          UserStatus  @default(ACTIVE)
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])

  groupMemberships     GroupMember[]
  messages             Message[]
  posts                Post[]
  comments             Comment[]
  materials            Material[]
  auditLogs            AuditLog[]            @relation("ActorLogs")
  reviewedApps         Application[]         @relation("ReviewedBy")
  verifiedPayments     Payment[]             @relation("VerifiedBy")
  continuationCheckIns ContinuationCheckIn[]
  likes                PostLike[]
  aiConversations      AIConversation[]
  enrollments          Enrollment[]
  unitRegistrations    UnitRegistration[]
  teachingAssignments  UnitLecturer[]

  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?

  createdAt DateTime @default(now())

  timetableEntriesAsLecturer TimetableEntry[] @relation("TimetableLecturer")
}

// ─────────────────────────────────────────────
// ACADEMIC STRUCTURE
// ─────────────────────────────────────────────

model Department {
  id        String    @id @default(uuid())
  name      String    @unique
  users     User[]
  programs  Program[]
  groups    Group[]
  createdAt DateTime  @default(now())
}

model Program {
  id                String     @id @default(uuid())
  departmentId      String
  department        Department @relation(fields: [departmentId], references: [id])
  name              String
  level             String?
  entryRequirements String?
  examBody          String?
  isShortCourse     Boolean    @default(false)

  units        Unit[]
  fees         ProgramFee[]
  enrollments  Enrollment[]
  applications Application[]
  groups       Group[]

  createdAt DateTime @default(now())

  @@unique([departmentId, name, level])
}

model ProgramFee {
  id            String   @id @default(uuid())
  programId     String
  program       Program  @relation(fields: [programId], references: [id])
  amount        Decimal
  effectiveFrom DateTime @default(now())
  setBy         String?
}

model Unit {
  id                  String             @id @default(uuid())
  programId           String
  program             Program            @relation(fields: [programId], references: [id])
  name                String
  materials           Material[]
  registrations       UnitRegistration[]
  lecturerAssignments UnitLecturer[]
  createdAt           DateTime           @default(now())
  timetableEntries    TimetableEntry[]
}

model Material {
  id         String   @id @default(uuid())
  unitId     String
  unit       Unit     @relation(fields: [unitId], references: [id])
  uploadedBy String
  uploader   User     @relation(fields: [uploadedBy], references: [id])
  fileUrl    String
  type       String
  version    Int      @default(1)
  createdAt  DateTime @default(now())
}

// ─────────────────────────────────────────────
// GROUPS & CHAT
// ─────────────────────────────────────────────

enum GroupType {
  CLASS
  DEPARTMENT
  SCHOOL
  TEACHERS
  ADMINS
}

model Group {
  id           String      @id @default(uuid())
  type         GroupType
  name         String
  programId    String?     @unique
  program      Program?    @relation(fields: [programId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  members  GroupMember[]
  messages Message[]

  createdAt DateTime @default(now())
}

model GroupMember {
  id          String   @id @default(uuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  roleInGroup String   @default("member")
  joinedAt    DateTime @default(now())

  @@unique([groupId, userId])
}

model Message {
  id            String   @id @default(uuid())
  groupId       String
  group         Group    @relation(fields: [groupId], references: [id])
  senderId      String
  sender        User     @relation(fields: [senderId], references: [id])
  content       String
  attachmentUrl String?
  createdAt     DateTime @default(now())
}

// ─────────────────────────────────────────────
// HOME FEED (public)
// ─────────────────────────────────────────────

model Post {
  id               String     @id @default(uuid())
  authorId         String?
  author           User?      @relation(fields: [authorId], references: [id])
  authorNamePublic String?
  content          String
  mediaUrl         String?
  mediaPublicId    String?
  comments         Comment[]
  likes            PostLike[]
  createdAt        DateTime   @default(now())
}

model PostLike {
  id String @id @default(uuid())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  guestId   String?
  guestName String?
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Comment {
  id               String   @id @default(uuid())
  postId           String
  post             Post     @relation(fields: [postId], references: [id])
  authorId         String?
  author           User?    @relation(fields: [authorId], references: [id])
  authorNamePublic String?
  content          String
  createdAt        DateTime @default(now())
}

// ─────────────────────────────────────────────
// ADMISSIONS PORTAL
// ─────────────────────────────────────────────

enum ApplicationStatus {
  SUBMITTED
  ADMITTED
  REJECTED
  WAITLISTED
  REPORTED
}

model Application {
  id            String            @id @default(uuid())
  applicantName String
  email         String
  phone         String
  idNumber      String
  programId     String
  program       Program           @relation(fields: [programId], references: [id])
  intake        String
  status        ApplicationStatus @default(SUBMITTED)
  documents     Json?
  reviewedById  String?
  reviewedBy    User?             @relation("ReviewedBy", fields: [reviewedById], references: [id])
  payments      Payment[]
  createdAt     DateTime          @default(now())
}

model Payment {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  amount        Decimal
  method        String
  reference     String?
  status        String      @default("pending")
  verifiedById  String?
  verifiedBy    User?       @relation("VerifiedBy", fields: [verifiedById], references: [id])
  createdAt     DateTime    @default(now())
}

// ─────────────────────────────────────────────
// TERM CONTINUATION (re-admission each term)
// ─────────────────────────────────────────────

// ─────────────────────────────────────────────
// ACADEMIC MANAGEMENT CORE
// ─────────────────────────────────────────────

// A student enrolled in a programme.
model Enrollment {
  id         String   @id @default(uuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id])
  programId  String
  program    Program  @relation(fields: [programId], references: [id])
  enrolledAt DateTime @default(now())
  status     String   @default("ACTIVE") // ACTIVE | COMPLETED | DEFERRED | WITHDRAWN

  unitRegistrations UnitRegistration[]

  createdAt DateTime @default(now())

  @@unique([studentId, programId])
}

// A student's registration for a specific unit during a term.
model UnitRegistration {
  id           String     @id @default(uuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  studentId    String
  student      User       @relation(fields: [studentId], references: [id])
  unitId       String
  unit         Unit       @relation(fields: [unitId], references: [id])
  termId       String
  term         Term       @relation(fields: [termId], references: [id])
  status       String     @default("REGISTERED") // REGISTERED | DROPPED | COMPLETED

  createdAt DateTime @default(now())

  @@unique([enrollmentId, unitId, termId])
}

// A lecturer/teacher assigned to teach a unit for a term.
model UnitLecturer {
  id         String @id @default(uuid())
  unitId     String
  unit       Unit   @relation(fields: [unitId], references: [id])
  lecturerId String
  lecturer   User   @relation(fields: [lecturerId], references: [id])
  termId     String
  term       Term   @relation(fields: [termId], references: [id])

  createdAt DateTime @default(now())

  @@unique([unitId, lecturerId, termId])
}

model Term {
  id                  String                @id @default(uuid())
  name                String                @unique // e.g. "Term 2 2026"
  startDate           DateTime
  endDate             DateTime?
  isActive            Boolean               @default(false)
  checkIns            ContinuationCheckIn[]
  registrations       UnitRegistration[]
  lecturerAssignments UnitLecturer[]
  createdAt           DateTime              @default(now())
  timetableEntries    TimetableEntry[]
}

model ContinuationCheckIn {
  id          String    @id @default(uuid())
  termId      String
  term        Term      @relation(fields: [termId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  status      String    @default("PENDING") // PENDING | CONFIRMED | DEFERRED
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([termId, userId])
}

// One row. Counts anonymous (not-logged-in) visits to the public Home feed —
// no identity or IP stored, just a number.
model VisitCounter {
  id    Int @id @default(1)
  count Int @default(0)
}

// ─────────────────────────────────────────────
// AI ASSISTANT (chat history)
// ─────────────────────────────────────────────

model AIConversation {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  title     String      @default("New chat")
  messages  AIMessage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id])
  role           String // 'user' | 'assistant'
  content        String
  createdAt      DateTime       @default(now())
}

// ─────────────────────────────────────────────
// AUDIT
// ─────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  actor     User     @relation("ActorLogs", fields: [actorId], references: [id])
  action    String
  target    String?
  createdAt DateTime @default(now())
}

model TimetableEntry {
  id String @id @default(cuid())

  unitId     String
  lecturerId String?
  termId     String

  dayOfWeek Int
  startTime String
  endTime   String

  room  String?
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  term Term @relation(fields: [termId], references: [id], onDelete: Cascade)

  lecturer User? @relation("TimetableLecturer", fields: [lecturerId], references: [id])

  @@unique([unitId, termId, dayOfWeek, startTime])
  @@index([termId])
  @@index([unitId])
}

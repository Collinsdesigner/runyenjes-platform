// Runyenjes Technical & Vocational College — Database Schema
// This file is the single source of truth for every table in the system.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// IDENTITY & SETTINGS
// ─────────────────────────────────────────────

// One row only. Holds the institution's name/branding so it can be
// changed from a settings screen later without touching any code.
model SiteSettings {
  id              Int    @id @default(1)
  institutionName String @default("Runyenjes Technical & Vocational College")
  shortName       String @default("Runyenjes")
  tagline         String @default("Empowering Through Skills and Technology")

  logoUrl      String?
  logoPublicId String?

  primaryColor     String   @default("#0B7A2B")
  secondaryColor   String   @default("#5C0F00")
  address          String   @default("P.O. Box 239-60103, Runyenjes")
  phone            String   @default("0797210054")
  email            String   @default("runyenjestti@gmail.com")
  website          String   @default("www.runyenjestechnical.ac.ke")
  about            String?
  physicalLocation String?
  googleMapsUrl    String?
  updatedAt        DateTime @default(now()) @updatedAt
}

enum Role {
  ADMIN
  REGISTRAR
  TEACHER
  STUDENT
  FINANCE_OFFICER
  HR_OFFICER
  EXAM_OFFICER
  STORES_OFFICER
  ALUMNI
  PROCUREMENT_OFFICER
  SUPPORT_STAFF
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model User {
  id              String      @id @default(uuid())
  name            String
  email           String      @unique
  passwordHash    String?
  admissionNumber String?     @unique
  phone           String?
  avatarUrl       String?
  avatarPublicId  String?
  role            Role
  status          UserStatus  @default(ACTIVE)
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])

  groupMemberships     GroupMember[]
  messages             Message[]
  posts                Post[]
  comments             Comment[]
  materials            Material[]
  auditLogs            AuditLog[]            @relation("ActorLogs")
  reviewedApps         Application[]         @relation("ReviewedBy")
  verifiedPayments     Payment[]             @relation("VerifiedBy")
  continuationCheckIns ContinuationCheckIn[]
  likes                PostLike[]
  aiConversations      AIConversation[]
  enrollments          Enrollment[]
  unitRegistrations    UnitRegistration[]
  teachingAssignments  UnitLecturer[]

  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?

  createdAt DateTime @default(now())

  timetableEntriesAsLecturer TimetableEntry[] @relation("TimetableLecturer")

  // Finance
  invoices             Invoice[]     @relation("StudentInvoices")
  feePaymentsRecorded  FeePayment[]  @relation("FeePaymentRecordedBy")

  // HR
  staffProfile    StaffProfile?
  leaveRequests   LeaveRequest[] @relation("StaffLeaveRequests")
  leaveApprovals  LeaveRequest[] @relation("LeaveApprovedBy")

  // Examinations
  examsCreated         Exam[]       @relation("ExamCreatedBy")
  examResults          ExamResult[] @relation("StudentExamResults")
  examResultsRecorded  ExamResult[] @relation("ExamResultRecordedBy")

  // Stores / Inventory
  stockMovementsRecorded StockMovement[] @relation("StockMovementRecordedBy")

  // Alumni
  alumniProfile AlumniProfile?

  // Procurement
  purchaseRequestsMade     PurchaseRequest[] @relation("PurchaseRequestedBy")
  purchaseRequestsApproved PurchaseRequest[] @relation("PurchaseRequestApprovedBy")
  jobPostings JobPosting[] @relation("JobPostingPostedBy")
}

// ─────────────────────────────────────────────
// ACADEMIC STRUCTURE
// ─────────────────────────────────────────────

model Department {
  id             String          @id @default(uuid())
  name           String          @unique
  users          User[]
  programs       Program[]
  groups         Group[]
  inventoryItems InventoryItem[]
  createdAt      DateTime        @default(now())
}

model Program {
  id                String     @id @default(uuid())
  departmentId      String
  department        Department @relation(fields: [departmentId], references: [id])
  name              String
  level             String?
  entryRequirements String?
  examBody          String?
  isShortCourse     Boolean    @default(false)

  units        Unit[]
  fees         ProgramFee[]
  enrollments  Enrollment[]
  applications Application[]
  groups       Group[]

  createdAt DateTime @default(now())

  @@unique([departmentId, name, level])
}

model ProgramFee {
  id            String   @id @default(uuid())
  programId     String
  program       Program  @relation(fields: [programId], references: [id])
  amount        Decimal
  effectiveFrom DateTime @default(now())
  setBy         String?
}

model Unit {
  id                  String             @id @default(uuid())
  programId           String
  program             Program            @relation(fields: [programId], references: [id])
  name                String
  materials           Material[]
  registrations       UnitRegistration[]
  lecturerAssignments UnitLecturer[]
  createdAt           DateTime           @default(now())
  timetableEntries    TimetableEntry[]
  exams               Exam[]
}

model Material {
  id         String   @id @default(uuid())
  unitId     String
  unit       Unit     @relation(fields: [unitId], references: [id])
  uploadedBy String
  uploader   User     @relation(fields: [uploadedBy], references: [id])
  fileUrl    String
  type       String
  version    Int      @default(1)
  createdAt  DateTime @default(now())
}

// ─────────────────────────────────────────────
// GROUPS & CHAT
// ─────────────────────────────────────────────

enum GroupType {
  CLASS
  DEPARTMENT
  SCHOOL
  TEACHERS
  ADMINS
  ALUMNI
}

model Group {
  id           String      @id @default(uuid())
  type         GroupType
  name         String
  programId    String?     @unique
  program      Program?    @relation(fields: [programId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  members  GroupMember[]
  messages Message[]

  createdAt DateTime @default(now())
}

model GroupMember {
  id          String   @id @default(uuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  roleInGroup String   @default("member")
  joinedAt    DateTime @default(now())

  @@unique([groupId, userId])
}

model Message {
  id            String   @id @default(uuid())
  groupId       String
  group         Group    @relation(fields: [groupId], references: [id])
  senderId      String
  sender        User     @relation(fields: [senderId], references: [id])
  content       String
  attachmentUrl String?
  createdAt     DateTime @default(now())
}

// ─────────────────────────────────────────────
// HOME FEED (public)
// ─────────────────────────────────────────────

model Post {
  id               String     @id @default(uuid())
  authorId         String?
  author           User?      @relation(fields: [authorId], references: [id])
  authorNamePublic String?
  content          String
  mediaUrl         String?
  mediaPublicId    String?
  comments         Comment[]
  likes            PostLike[]
  createdAt        DateTime   @default(now())
}

model PostLike {
  id String @id @default(uuid())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  guestId   String?
  guestName String?
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Comment {
  id               String   @id @default(uuid())
  postId           String
  post             Post     @relation(fields: [postId], references: [id])
  authorId         String?
  author           User?    @relation(fields: [authorId], references: [id])
  authorNamePublic String?
  content          String
  createdAt        DateTime @default(now())
}

// ─────────────────────────────────────────────
// ADMISSIONS PORTAL
// ─────────────────────────────────────────────

enum ApplicationStatus {
  SUBMITTED
  ADMITTED
  REJECTED
  WAITLISTED
  REPORTED
}

model Application {
  id            String            @id @default(uuid())
  applicantName String
  email         String
  phone         String
  idNumber      String
  programId     String
  program       Program           @relation(fields: [programId], references: [id])
  intake        String
  status        ApplicationStatus @default(SUBMITTED)
  documents     Json?
  reviewedById  String?
  reviewedBy    User?             @relation("ReviewedBy", fields: [reviewedById], references: [id])
  payments      Payment[]
  createdAt     DateTime          @default(now())
}

model Payment {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  amount        Decimal
  method        String
  reference     String?
  status        String      @default("pending")
  verifiedById  String?
  verifiedBy    User?       @relation("VerifiedBy", fields: [verifiedById], references: [id])
  createdAt     DateTime    @default(now())
}

// ─────────────────────────────────────────────
// TERM CONTINUATION (re-admission each term)
// ─────────────────────────────────────────────

// ─────────────────────────────────────────────
// ACADEMIC MANAGEMENT CORE
// ─────────────────────────────────────────────

// A student enrolled in a programme.
model Enrollment {
  id         String   @id @default(uuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id])
  programId  String
  program    Program  @relation(fields: [programId], references: [id])
  enrolledAt DateTime @default(now())
  status     String   @default("ACTIVE") // ACTIVE | COMPLETED | DEFERRED | WITHDRAWN

  unitRegistrations UnitRegistration[]

  createdAt DateTime @default(now())

  @@unique([studentId, programId])
}

// A student's registration for a specific unit during a term.
model UnitRegistration {
  id           String     @id @default(uuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  studentId    String
  student      User       @relation(fields: [studentId], references: [id])
  unitId       String
  unit         Unit       @relation(fields: [unitId], references: [id])
  termId       String
  term         Term       @relation(fields: [termId], references: [id])
  status       String     @default("REGISTERED") // REGISTERED | DROPPED | COMPLETED

  createdAt DateTime @default(now())

  @@unique([enrollmentId, unitId, termId])
}

// A lecturer/teacher assigned to teach a unit for a term.
model UnitLecturer {
  id         String @id @default(uuid())
  unitId     String
  unit       Unit   @relation(fields: [unitId], references: [id])
  lecturerId String
  lecturer   User   @relation(fields: [lecturerId], references: [id])
  termId     String
  term       Term   @relation(fields: [termId], references: [id])

  createdAt DateTime @default(now())

  @@unique([unitId, lecturerId, termId])
}

model Term {
  id                  String                @id @default(uuid())
  name                String                @unique // e.g. "Term 2 2026"
  startDate           DateTime
  endDate             DateTime?
  isActive            Boolean               @default(false)
  checkIns            ContinuationCheckIn[]
  registrations       UnitRegistration[]
  lecturerAssignments UnitLecturer[]
  createdAt           DateTime              @default(now())
  timetableEntries    TimetableEntry[]
  invoices            Invoice[]
  exams               Exam[]
}

model ContinuationCheckIn {
  id          String    @id @default(uuid())
  termId      String
  term        Term      @relation(fields: [termId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  status      String    @default("PENDING") // PENDING | CONFIRMED | DEFERRED
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([termId, userId])
}

// One row. Counts anonymous (not-logged-in) visits to the public Home feed —
// no identity or IP stored, just a number.
model VisitCounter {
  id    Int @id @default(1)
  count Int @default(0)
}

// ─────────────────────────────────────────────
// AI ASSISTANT (chat history)
// ─────────────────────────────────────────────

model AIConversation {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  title     String      @default("New chat")
  messages  AIMessage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id])
  role           String // 'user' | 'assistant'
  content        String
  createdAt      DateTime       @default(now())
}

// ─────────────────────────────────────────────
// AUDIT
// ─────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  actor     User     @relation("ActorLogs", fields: [actorId], references: [id])
  action    String
  target    String?
  createdAt DateTime @default(now())
}

model TimetableEntry {
  id String @id @default(cuid())

  unitId     String
  lecturerId String?
  termId     String

  dayOfWeek Int
  startTime String
  endTime   String

  room  String?
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  term Term @relation(fields: [termId], references: [id], onDelete: Cascade)

  lecturer User? @relation("TimetableLecturer", fields: [lecturerId], references: [id])

  @@unique([unitId, termId, dayOfWeek, startTime])
  @@index([termId])
  @@index([unitId])
}

// ─────────────────────────────────────────────
// FINANCE MODULE
// ─────────────────────────────────────────────
// Lean v1: invoices billed to a student for a term, with payments recorded
// against them. Kept separate from the admissions Payment model above,
// which is specifically for application fees.

enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id          String        @id @default(uuid())
  studentId   String
  student     User          @relation("StudentInvoices", fields: [studentId], references: [id])
  termId      String
  term        Term          @relation(fields: [termId], references: [id])
  description String
  amount      Decimal
  dueDate     DateTime?
  status      InvoiceStatus @default(PENDING)

  payments  FeePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([termId])
}

model FeePayment {
  id            String   @id @default(uuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  amount        Decimal
  method        String // CASH | MPESA | BANK | CHEQUE | OTHER
  reference     String?
  recordedById  String
  recordedBy    User     @relation("FeePaymentRecordedBy", fields: [recordedById], references: [id])
  paidAt        DateTime @default(now())

  @@index([invoiceId])
}

// ─────────────────────────────────────────────
// HUMAN RESOURCES MODULE
// ─────────────────────────────────────────────
// Lean v1: one profile per staff User, plus leave requests. Payroll is
// deliberately out of scope for now — this is enough to test real HR
// workflows end-to-end.

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

model StaffProfile {
  id             String         @id @default(uuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id])
  employeeNumber String?        @unique
  position       String?
  employmentType EmploymentType @default(FULL_TIME)
  dateHired      DateTime?
  nationalId     String?
  status         StaffStatus    @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id           String      @id @default(uuid())
  staffId      String
  staff        User        @relation("StaffLeaveRequests", fields: [staffId], references: [id])
  type         LeaveType
  startDate    DateTime
  endDate      DateTime
  reason       String?
  status       LeaveStatus @default(PENDING)
  approvedById String?
  approvedBy   User?       @relation("LeaveApprovedBy", fields: [approvedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
}

// ─────────────────────────────────────────────
// EXAMINATIONS MODULE
// ─────────────────────────────────────────────
// Lean v1: an Exam belongs to a Unit + Term (reuses existing academic
// structure); ExamResult records one student's score for that exam.

model Exam {
  id          String   @id @default(uuid())
  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id])
  termId      String
  term        Term     @relation(fields: [termId], references: [id])
  name        String // e.g. "CAT 1", "End of Term Exam"
  examDate    DateTime?
  maxScore    Decimal  @default(100)
  weight      Decimal? // optional weighting toward final grade
  createdById String
  createdBy   User     @relation("ExamCreatedBy", fields: [createdById], references: [id])

  results ExamResult[]

  createdAt DateTime @default(now())

  @@index([unitId])
  @@index([termId])
}

model ExamResult {
  id           String   @id @default(uuid())
  examId       String
  exam         Exam     @relation(fields: [examId], references: [id])
  studentId    String
  student      User     @relation("StudentExamResults", fields: [studentId], references: [id])
  score        Decimal
  grade        String?
  remarks      String?
  recordedById String
  recordedBy   User     @relation("ExamResultRecordedBy", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, studentId])
}

// ─────────────────────────────────────────────
// STORES / INVENTORY MODULE
// ─────────────────────────────────────────────
// Lean v1: item catalog with a running quantityOnHand, plus a movement
// log (receipts/issues/adjustments) that is the audit trail for how
// quantityOnHand changed over time.

enum StockMovementType {
  RECEIPT
  ISSUE
  ADJUSTMENT
}

model InventoryItem {
  id               String   @id @default(uuid())
  name             String
  category         String?
  uom              String   @default("pcs") // unit of measure: pcs, kg, litres, etc.
  quantityOnHand   Decimal  @default(0)
  reorderLevel     Decimal  @default(0)
  departmentId     String?
  department       Department? @relation(fields: [departmentId], references: [id])

  movements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  purchaseRequests PurchaseRequest[]
}

model StockMovement {
  id           String            @id @default(uuid())
  itemId       String
  item         InventoryItem     @relation(fields: [itemId], references: [id])
  type         StockMovementType
  quantity     Decimal
  reason       String?
  recordedById String
  recordedBy   User              @relation("StockMovementRecordedBy", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())

  @@index([itemId])
}

// ─────────────────────────────────────────────
// ALUMNI
// ─────────────────────────────────────────────
// A graduated student's account keeps its role changed from STUDENT to
// ALUMNI (preserving all existing enrollment/academic history) and gets
// this profile attached for post-graduation info.

model AlumniProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id])
  graduationYear   Int?
  currentEmployer  String?
  currentPosition  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// PROCUREMENT
// ─────────────────────────────────────────────
// Lean v1: a purchase request references an existing Stores InventoryItem
// (rather than free-text), so approving + receiving a request can restock
// that item directly through the existing Stores module.

enum PurchaseRequestStatus {
  PENDING
  APPROVED
  REJECTED
  ORDERED
  RECEIVED
}

model PurchaseRequest {
  id             String                @id @default(uuid())
  itemId         String
  item           InventoryItem         @relation(fields: [itemId], references: [id])
  quantity       Decimal
  justification  String?
  status         PurchaseRequestStatus @default(PENDING)
  requestedById  String
  requestedBy    User                  @relation("PurchaseRequestedBy", fields: [requestedById], references: [id])
  approvedById   String?
  approvedBy     User?                 @relation("PurchaseRequestApprovedBy", fields: [approvedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemId])
  @@index([requestedById])
}

// ─────────────────────────────────────────────
// JOB CONNECTION
// ─────────────────────────────────────────────
// Any staff member or alumnus can post an opening; alumni (and admin, for
// moderation) browse open postings; the poster or an admin can close or
// remove their own listing.

enum JobPostingStatus {
  OPEN
  CLOSED
}

model JobPosting {
  id           String           @id @default(uuid())
  title        String
  company      String
  location     String?
  description  String
  applyLink    String?
  contactEmail String?
  status       JobPostingStatus @default(OPEN)
  postedById   String
  postedBy     User             @relation("JobPostingPostedBy", fields: [postedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postedById])
  @@index([status])
}
